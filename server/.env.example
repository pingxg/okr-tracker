# Copy to server/.env for local development: cp server/.env.example server/.env
# All variables are read in server/src/config.js. Empty values use the default.

# --- Server -----------------------------------------------------------------
# development | production (production requires SESSION_SECRET)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Base URL users open in the browser; used for OIDC redirects.
# Local dev with Vite: http://localhost:8080
PUBLIC_URL=http://localhost:8080
# Number of reverse proxies in front of the server (Render: 1)
TRUST_PROXY_HOPS=1

# --- Database ---------------------------------------------------------------
# Local:  postgres://okr:okr@localhost:5432/okr
# Render: use the "External Database URL" from the database's Connect menu
#         and set DATABASE_SSL=true
DATABASE_URL=postgres://okr:okr@localhost:5432/okr
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Set to true to start without applying migrations from src/db/migrations
SKIP_MIGRATIONS=false

# --- Sessions ---------------------------------------------------------------
# Long random string; required in production
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12

# --- Sign-in ----------------------------------------------------------------
# Email + shared password sign-in for development and test only.
# Leave empty in production.
DEV_LOGIN_PASSWORD=okr-dev

# OpenID Connect (Microsoft Entra ID or any other provider)
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# Create a user with no roles on first SSO login
AUTO_CREATE_USERS=true
# Comma-separated emails that become super admin on first login
INITIAL_ADMIN_EMAIL=admin@example.com

# --- Other ------------------------------------------------------------------
# Run audit log, slug and progress triggers after writes
HOOKS_ENABLED=true
# Directory with the built frontend; defaults to ../dist
# STATIC_DIR=
